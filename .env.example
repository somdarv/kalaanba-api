APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# The origin this API actually answers on. Load-bearing beyond mail links:
# `Storage::disk('public')->url()` builds every local media URL from it, so a
# value that omits the port hands the frontend `http://localhost/storage/...`,
# which resolves to nothing and shows up as a broken avatar rather than as a
# configuration error. `php artisan serve` listens on 8000.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\\Formatter\\JsonFormatter

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sentry (Phase 0.8 Observability) ---
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# --- BMS / Bulk Messaging Solutions (OTP delivery, ADR-0009) ---
# The live OTP gateway. NOTE the host says mnotify: BMS is the current brand of
# mNotify and the API still answers on api.mnotify.com. bms.africa is the
# marketing site and does NOT serve the API.
BMS_API_KEY=
BMS_BASE_URL=https://api.mnotify.com
BMS_TIMEOUT_SECONDS=10

# --- SMSOnlineGH (superseded as the OTP gateway by ADR-0009, driver retained) ---
# Transport credential only. The sender ID and message wording are admin config
# keys (auth.otp.sms.sender_id, auth.otp.sms.message_template), not env vars.
# Leave the key blank in dev: auth.otp_provider stays "mock" and nothing is sent.
SMSONLINEGH_API_KEY=
SMSONLINEGH_BASE_URL=https://api.smsonlinegh.com
SMSONLINEGH_TIMEOUT_SECONDS=10

# --- Cloudflare R2 (player + user media storage) ---
# Object storage for player photos (POST /api/v1/players/{id}/media) and, once
# migrated, user avatars. Bucket per environment: kalaanba-dev-storage,
# kalaanba-prod-storage.
#
# READ THIS BEFORE FILLING IT IN. R2 speaks the S3 API and wants an ACCESS KEY
# PAIR, which is not the same object as a Cloudflare account API token. Create
# it under R2 > Manage R2 API Tokens; Cloudflare shows the Access Key ID and the
# Secret Access Key once, at creation. An account API token from
# My Profile > API Tokens will authenticate against api.cloudflare.com and will
# NOT authenticate against the S3 endpoint, which is the mistake this comment
# exists to stop someone repeating.
#
# The account ID is not a secret; it is half of the endpoint hostname.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kalaanba-dev-storage
# Public base URL the stored object resolves at: the bucket's r2.dev address,
# or a custom domain. Player media is public content, not evidence, so this is
# a plain URL and never a signed one (engineering-standards §11 reserves signed
# URLs for the evidence bucket).
R2_PUBLIC_URL=

# Which driver Player media uses: 'local' (dev default, storage/app/public) or
# 'r2'. Mirrors USERS_AVATAR_DRIVER.
PLAYER_MEDIA_DRIVER=local
